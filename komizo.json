{
  "version": 1,
  "recipe": "go-cli",
  "repository": "aviorstudio/termcade-games",
  "tools": {
    "actionlint": "1.7.12",
    "shellcheck": "0.11.0"
  },
  "artifacts": [
    "asteroid/build",
    "brickough/build",
    "tetris/build"
  ],
  "stages": {
    "install": [
      [
        "env",
        "GOWORK=off",
        "go",
        "mod",
        "download"
      ]
    ],
    "lint": [
      [
        "env",
        "GOWORK=off",
        "go",
        "vet",
        "./..."
      ],
      [
        "python3",
        "scripts/check-release-workflow.py",
        ".github/workflows/release.yml"
      ],
      [
        "actionlint"
      ],
      [
        "shellcheck",
        "scripts/build.sh"
      ]
    ],
    "unit": [
      [
        "env",
        "GOWORK=off",
        "go",
        "test",
        "./..."
      ],
      [
        "python3",
        "scripts/test-recover-catalog.py"
      ]
    ],
    "build": [
      [
        "bash",
        "scripts/build.sh"
      ]
    ],
    "artifact-check": {
      "inapplicable": "The caller build uses the pinned Termcade package compiler, which validates each WASM package"
    },
    "dev": {
      "inapplicable": "Interactive CLI usage requires a caller-owned terminal and configuration"
    },
    "stop": {
      "inapplicable": "The CLI owns no background development service"
    },
    "clean": [
      [
        "python3",
        "-c",
        "import shutil; [shutil.rmtree(p,ignore_errors=True) for p in ['asteroid/build', 'brickough/build', 'tetris/build', '.artifacts']]"
      ]
    ]
  },
  "validation": {
    "workflow": {
      "required": [
        "ci.yml",
        "dependency-policy.yml",
        "release.yml"
      ],
      "ci_gates": [
        "Test"
      ]
    }
  }
}
